# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side service role (for /api/auth/verify upserts)
SUPABASE_SERVICE_KEY=

# Auth (SIWE cookie signing; 32+ random bytes, hex or base64)
AUTH_SECRET=

# WalletConnect project id (optional; only required if users pick WC)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Admin wallet allowlist (comma-separated, lowercase)
ADMIN_WALLETS=

# Orchestrator
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:4000

# Worker WS URL (temp, until orchestrator routing ships)
NEXT_PUBLIC_WORKER_WS_URL=ws://localhost:5001

# Token mode (false = pre-launch / admin-allowlist deploys only)
NEXT_PUBLIC_TOKEN_LIVE=false
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_PAYMENTS_ADDRESS=

# Chain
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_ALCHEMY_KEY=
